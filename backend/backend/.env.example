# FoodLoop environment configuration
# Copy to backend/.env and adjust. NEVER commit a real .env file.
# Every value below is a safe placeholder. The complete workflow runs on these
# defaults with no paid credentials and no network access.

# ---------- application ----------
APP_ENV=dev
LOG_LEVEL=INFO
LOG_FORMAT=console                  # console | json
DEFAULT_TIMEZONE=Asia/Kolkata

# ---------- database ----------
# Async URL used by the application.
DATABASE_URL=postgresql+psycopg://foodloop:foodloop@localhost:5432/foodloop
# Sync URL used by Alembic. Same database, different driver prefix.
DATABASE_URL_SYNC=postgresql+psycopg://foodloop:foodloop@localhost:5432/foodloop

# ---------- auth ----------
# Generate your own:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-long-random-string
JWT_ALG=HS256
ACCESS_TOKEN_TTL_MIN=30

# ---------- LLM provider ----------
# mock = deterministic, offline, needs no key. Keep this for all tests: the
# suite must not depend on a network call or a billing account.
#
# anthropic = real extraction via Claude. Needs `uv sync --extra llm` and a key
# from console.anthropic.com. NOTE a claude.ai Pro subscription does NOT include
# API access; Max and Team plans include monthly API credits that must be linked
# to a Console organization first.
#
# ollama = a real model running on this machine. No key, no account, no cost,
# no internet. Needs `uv sync --extra llm`, Ollama installed, and the model
# pulled: `ollama pull llama3.2:3b`. CPU inference is slow -- raise the timeout.
LLM_PROVIDER=mock                   # mock | anthropic | openai | ollama
LLM_API_KEY=                        # anthropic only
LLM_MODEL=                          # blank -> claude-haiku-5-5 / llama3.2:3b
LLM_TIMEOUT_S=20                    # raise to 120 for ollama
LLM_BASE_URL=http://localhost:11434 # ollama only

# ---------- routing provider ----------
# simulated = seeded haversine distance x a road factor, tagged SIMULATED.
ROUTING_PROVIDER=simulated          # simulated | osrm | ors
OSRM_BASE_URL=
ORS_API_KEY=
ROAD_FACTOR=1.35                    # straight-line km -> estimated road km

# ---------- geocoding provider ----------
# Seed data ships with real coordinates, so dev never needs to geocode.
GEOCODER_PROVIDER=simulated         # simulated | nominatim
NOMINATIM_BASE_URL=

# ---------- notifications ----------
# console writes a notifications row AND logs it, so it is inspectable.
NOTIFY_PROVIDER=console             # console | smtp | twilio
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- safety policy ----------
# The ruleset file in app/services/safety/rulesets/. The engine refuses to load
# a ruleset whose policy_status key is missing.
SAFETY_RULESET_VERSION=demo_v1

# ---------- workflow timings and bounds ----------
RESERVATION_HOLD_MINUTES=20
CONFIRMATION_TIMEOUT_MINUTES=15
MAX_CANDIDATE_ATTEMPTS=3
MAX_NODE_RETRIES=3
MAX_CLARIFICATION_ROUNDS=2
MAX_SEARCH_WIDENINGS=2

# ---------- matching ----------
SEARCH_RADIUS_METERS_DEFAULT=8000
SEARCH_RADIUS_WIDEN_FACTOR=1.5

# ---------- background sweeper ----------
SCHEDULER_ENABLED=true
SCHEDULER_POLL_SECONDS=15

# ---------- CORS ----------
# Explicit list. Never "*", not even in dev.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
